{
    "functions": {
        "src/routes/api/arena/[matchId]/submit/+server.ts": {
            "maxDuration": 60
        }
    },
    "headers": [
        {
            "source": "/arena/:path*",
            "headers": [
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        }
    ],
    "github": {
        "silent": true,
        "autoJobCancelation": true
    },
    "buildCommand": "pnpm test && pnpm build"
}
