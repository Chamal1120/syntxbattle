{
    "extends": ["stylelint-config-standard", "stylelint-config-recess-order"],
    "rules": {
        "no-empty-source": null,
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": ["apply", "variants", "responsive", "screen"]
            }
        ],
        "import-notation": "string"
    }
}
